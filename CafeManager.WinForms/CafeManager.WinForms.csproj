    </Compile>
    <Compile Update="Forms\CategoryManagementForm.Designer.cs">
      <DependentUpon>CategoryManagementForm.cs</DependentUpon>
    </Compile>
    <Compile Update="Forms\ChangePasswordForm.cs">
      <SubType>Form</SubType>
    </Compile>
